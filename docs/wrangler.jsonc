// docs サイト (Astro/Starlight + /storybook/) の Cloudflare Workers デプロイ設定。
// デプロイ: pnpm build:all && pnpm deploy:docs (環境変数 CLOUDFLARE_API_TOKEN が必要)
// 認証まわりは auth-worker.js を参照。
// ※ この Worker (novads) 以外の Cloudflare リソースには触れない。
{
  "name": "novads",
  "main": "./auth-worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
