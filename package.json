  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build:tokens": "node scripts/build-tokens.mjs",
    "figma:pull": "node scripts/fetch-figma-tokens.mjs",
    "figma:theme-check": "node scripts/figma/component-theme-check.mjs",
    "figma:icons": "node scripts/figma/generate-icon-code-connect.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.build.json",
    "package:check": "npm pack --dry-run",
    "test": "node scripts/quality/run-vitest-safe.mjs -- run --project unit --project storybook --project storybook-dark",
    "test:watch": "vitest --project unit --project storybook --project storybook-dark",
    "test:unit": "node scripts/quality/run-vitest-safe.mjs -- run --project unit",
    "test:storybook": "node scripts/quality/run-vitest-safe.mjs -- run --project storybook",
    "test:storybook:dark": "node scripts/quality/run-vitest-safe.mjs -- run --project storybook-dark",
    "test:api": "vitest run --project api",
    "test:package": "node scripts/quality/verify-package.mjs && node scripts/quality/verify-treeshaking.mjs",
    "test:tokens": "node scripts/quality/verify-tokens.mjs",
    "test:foundation": "node scripts/quality/verify-motion-and-theme.mjs",
    "test:full": "pnpm typecheck && eslint src/components src/utils test scripts/quality vite.config.ts && pnpm test:api && pnpm test:unit && pnpm test:storybook && pnpm test:storybook:dark && pnpm test:tokens && pnpm build && pnpm build-storybook && pnpm test:package && pnpm test:foundation",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "build:storybook": "STORYBOOK_BASE_PATH=/storybook/ storybook build -o docs/public/storybook",
    "build:all": "pnpm build:storybook && pnpm docs:build",
    "deploy:docs": "wrangler deploy --config docs/wrangler.jsonc",
    "typecheck:figma": "tsc -p tsconfig.figma.json --noEmit",
    "code-connect:check": "node scripts/code-connect-publish.mjs --dry-run",
    "code-connect:build": "pnpm run typecheck:figma && pnpm run code-connect:check",
    "code-connect:publish": "node scripts/code-connect-publish.mjs"
  },
